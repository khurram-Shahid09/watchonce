# WatchOnce environment variables (local development)
# Copy to .env and fill in values. Never commit .env.
# Production values are documented in docs/13-deployment-ops.md.

# --- Core (Django) ---
APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=            # 50+ random characters; also signs JWTs
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgres://watchonce:watchonce@localhost:5433/watchonce
REDIS_URL=redis://localhost:6379/0
SECRETS_MASTER_KEY=           # base64-encoded 32 random bytes
CORS_ORIGINS=http://localhost:3000

# --- Object storage (SeaweedFS S3 locally, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=watchonce-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- AI ---
LLM_PROVIDER=gemini           # gemini (free tier, demo data only) | claude
# LLM_PROVIDER_REPAIR=        # optional per-stage override
GEMINI_API_KEY=
GEMINI_MODEL=                 # current Gemini vision model, set when implementing
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT_UNDERSTAND=high
CLAUDE_EFFORT_SOP=medium
CLAUDE_EFFORT_REPAIR=high
LLM_MONTHLY_BUDGET_USD=10

# --- Auth (optional; email login works without it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Observability (optional locally) ---
SENTRY_DSN_API=
SENTRY_DSN_WEB=
