{
  "name": "watchonce",
  "private": true,
  "packageManager": "pnpm@12.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @watchonce/web dev",
    "dev:portal": "pnpm --filter @watchonce/acme-portal dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "spec:gen": "pnpm --filter @watchonce/spec gen",
    "eval:compile": "cd services/core && uv run python manage.py eval_compile",
    "eval:heal": "cd services/core && uv run python manage.py eval_heal"
  }
}
