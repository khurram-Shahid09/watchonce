{
  "name": "@watchonce/spec",
  "version": "1.0.0",
  "private": true,
  "description": "WatchOnce workflow spec: JSON Schema (source of truth) and generated TypeScript types.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./workflow.schema.json": "./workflow.schema.json"
  },
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5"
  }
}
