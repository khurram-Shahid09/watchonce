{
  "name": "@watchonce/extension",
  "version": "0.1.0",
  "private": true,
  "description": "WatchOnce recorder: Chrome MV3 extension that captures a task demonstration.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
